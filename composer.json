{
  "name": "demo/cherry",
  "description": "Cherry — a lightweight blog built with PHP, PDO/MySQL and Smarty.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1 <9.0",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "smarty/smarty": "5.9.0",
    "vlucas/phpdotenv": "5.8.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "lint": "@php bin/lint.php",
    "test": "@php tests/run.php",
    "db:seed": "@php bin/seed.php"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.1.0"
    },
    "allow-plugins": {}
  }
}
