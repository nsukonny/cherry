{
  "name": "cherry-layouts",
  "description": "Вёрстка блога Cherry: HTML, SCSS (БЭМ) и JS. Сборка кладёт файлы в ../public/assets.",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node gulp_scripts/start.js",
    "build": "gulp --gulpfile gulp_scripts/gulpfile.js --cwd . build --prod",
    "build:dev": "gulp --gulpfile gulp_scripts/gulpfile.js --cwd . build"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.0",
    "browser-sync": "^3.0.4",
    "cssnano": "^7.0.0",
    "del": "^8.0.1",
    "esbuild": "^0.27.0",
    "fast-glob": "^3.3.0",
    "gulp": "^5.0.1",
    "gulp-cli": "^3.1.0",
    "gulp-esbuild": "^0.14.1",
    "gulp-file-include": "^2.3.0",
    "gulp-newer": "^1.4.0",
    "gulp-plumber": "^1.2.1",
    "gulp-postcss": "^10.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-sass": "^6.0.1",
    "minimist": "^1.2.0",
    "sass": "^1.60.0"
  },
  "dependencies": {
    "@fontsource-variable/rubik": "^5.1.0",
    "@fontsource-variable/unbounded": "^5.1.0"
  }
